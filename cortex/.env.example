# ═══════════════════════════════════════════════════════════════════════════
# Cortex — configuration d'environnement (copie ce fichier en .env.local)
# .env.local n'est JAMAIS commité (cf. .gitignore).
#
# TOUT est optionnel : sans aucun fichier .env.local, l'app tourne en mode
# historique « dev €0 » : moteur = Claude Code (`claude -p`) via l'abonnement
# Max, base = SQLite locale (data/), aucun service externe.
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────── Moteur LLM (Phase A) ─────────────────────────
# Provider des appels IA : claude-code (défaut, €0 via Max) | anthropic (API
# officielle payante) | openai-compatible (endpoint générique /chat/completions,
# ex. NVIDIA NIM build.nvidia.com — gratuit —, vLLM, OpenRouter…).
# LLM_PROVIDER=claude-code

# Clé API des providers API (anthropic / openai-compatible si le endpoint l'exige).
# Repli accepté : ANTHROPIC_API_KEY (historique).
# LLM_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint du provider openai-compatible (racine SANS /chat/completions).
# Ex. NVIDIA NIM : https://integrate.api.nvidia.com/v1
# (Sert aussi de baseURL de test pour le provider anthropic.)
# LLM_BASE_URL=

# Mapping des modèles logiques (opus/sonnet/haiku) vers les ids du backend.
# claude-code : inutile (le CLI comprend les alias). anthropic : défauts
# claude-opus-4-8 / claude-sonnet-5 / claude-haiku-4-5-20251001.
# openai-compatible : FORTEMENT recommandé (aucun défaut sensé).
# LLM_MODEL_OPUS=
# LLM_MODEL_SONNET=
# LLM_MODEL_HAIKU=

# Concurrence max des appels LLM (limiteur global, file FIFO). Défaut : 4.
# LLM_MAX_CONCURRENCY=4

# RE-tentatives sur erreur retryable (429/5xx/réseau), backoff exponentiel+jitter.
# Défaut : 0 pour claude-code (comportement historique), 2 pour les providers API.
# LLM_MAX_RETRIES=
# LLM_RETRY_BASE_MS=500

# Chemin du binaire claude si non détecté automatiquement (PATH + emplacements connus).
# CORTEX_CLAUDE_BIN=/opt/homebrew/bin/claude

# ───────────────────────────── Base de données (Phase B) ────────────────────
# Driver : sqlite (défaut — fichiers data/, dev €0, mono-user « owner ») |
# postgres (produit multi-user : un schéma par (user, cours) via search_path).
# DB_DRIVER=sqlite

# Cible Postgres (requis si DB_DRIVER=postgres) :
#  - vrai serveur :   postgres://cortex:cortex@localhost:5433/cortex  (cf. docker-compose.yml)
#  - PGlite embarqué : pglite://./data/pg   (Postgres WASM in-process, zéro Docker — tests/démo)
# DATABASE_URL=
# Connexions max par tenant (postgres.js). Défaut : 3.
# PG_POOL_MAX=3
# Pools tenant gardés vivants simultanément (éviction LRU au-delà) — borne la
# consommation de max_connections quand beaucoup d'utilisateurs sont actifs.
# PG_MAX_TENANT_POOLS=8

# Migration des données locales : npx tsx scripts/migrate-to-postgres.ts [--user owner] [--drop]

# ───────────────────────────── Authentification (Phase B4) ──────────────────
# OPT-IN : sans AUTH_ENABLED=1, AUCUNE auth (mono-user owner, comportement
# historique). Avec auth : toute page/API exige une session (magic-link e-mail
# + Google OAuth optionnel), l'utilisateur devient le tenant des données.
# AUTH_ENABLED=1
# AUTH_SECRET=  # requis si AUTH_ENABLED=1 — génère : openssl rand -base64 32

# Envoi du magic-link : sans endpoint, le lien est LOGGÉ dans la console du
# serveur (dev €0). Sinon POST {to, url, subject} sur l'endpoint (Resend, worker…).
# AUTH_EMAIL_ENDPOINT=
# AUTH_EMAIL_TOKEN=
# AUTH_EMAIL_FROM=cortex@localhost

# Google OAuth (optionnel) :
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Utilisateur des scripts CLI en mode postgres (défaut : owner).
# CORTEX_USER=owner

# ──────────────────────── Cache / observabilité (Phase E) ───────────────────
# Cache LLM par hash de contenu (prompt+modèle+params) : le 2ᵉ appel identique
# ne rappelle pas le modèle (table llm_cache du tenant). OPT-IN. Défaut : off.
# CACHE_ENABLED=1

# Log structuré : niveau (debug|info|warn|error, défaut info) + format.
# LOG_LEVEL=info
# LOG_PRETTY=1   # lignes lisibles au lieu de JSON (dev)

# /api/metrics est PROTÉGÉ : sans ce token il répond 401. /api/health est public.
# METRICS_TOKEN=change-me

# ─────────────────────── Sandbox d'exécution (Phase D/E) ─────────────────────
# Binaires utilisés dans le bac à sable (cf. cortex/docs/SANDBOX.md).
# CORTEX_PYTHON=python3
# CORTEX_CC=cc
# CORTEX_SANDBOX=none   # (tests) force « aucune isolation » → exécution refusée

# ─────────────────────────── Génération / jobs (existant) ───────────────────
# Timeout du lot de génération d'examen (ms). Défaut : 600000.
# CORTEX_BATCH_TIMEOUT_MS=600000
# Cours par défaut des scripts CLI (sinon cs-202).
# CORTEX_COURSE=cs-202

# ───────────────────── Déploiement v1 (conteneur / prod) ─────────────────────
# Racine des données mutables (volume persistant Railway). Non posée → ./data
# (dev/CI, comportement historique). Au 1er boot avec un volume vide, prod-boot
# y copie le contenu committé sans écraser l'existant.
# CORTEX_DATA_DIR=/data

# Seed au boot (scripts/prod-boot.ts, appelé par docker-entrypoint.sh) : cours
# à hydrater depuis le contenu COMMITTÉ si le tenant du user de seed est vide
# (aucun appel LLM). Le Dockerfile pose ml par défaut ; "" désactive.
# CORTEX_SEED_COURSES=ml
# CORTEX_SEED_USER=owner

# Postgres : un NOUVEL utilisateur reçoit une copie SQL du contenu de cours du
# tenant de seed (sources/items/annales/programme/banque — jamais les données
# personnelles). Sans ça, un nouveau compte a un tenant vide → rien à générer.
# SEED_NEW_TENANTS=1

# ── Garde-fous de COÛT (RÈGLE D'OR n°2 — obligatoires avant tout déploiement) ──
# Plafond de dépense GLOBAL en USD (somme table llm_usage, store auth global).
# Atteint → les appels des providers PAYANTS sont refusés (LlmError SPEND_CAP,
# HTTP 503 avec message clair) ; claude-code (dev €0) n'est jamais bloqué.
# Non posé → pas de plafond (dev). EN PROD : POSE-LE.
# SPEND_CAP_USD=25

# Sur le provider anthropic (payant), l'alias logique « opus » se résout vers
# SONNET par défaut (Opus coûte ~5× plus cher en entrée). Opus réel seulement
# si LLM_ALLOW_OPUS=1 (ou LLM_MODEL_OPUS posé explicitement).
# LLM_ALLOW_OPUS=

# Logger aussi les appels claude-code (coût 0) dans llm_usage (télémétrie).
# CORTEX_TRACK_USAGE=

# ── Auth prod (complète la section Authentification ci-dessus) ───────────────
# Envoi RÉEL du magic-link via Resend (recommandé en prod ; sinon
# AUTH_EMAIL_ENDPOINT générique, sinon lien loggé en console = fuite dans les
# logs du conteneur → à éviter en prod).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# AUTH_EMAIL_FROM=Cortex <cortex@ton-domaine.ch>
# URL canonique du site (liens magic-link + cookies https derrière le proxy).
# AUTH_URL=https://cortex.ton-domaine.ch

# Lancement FERMÉ : INVITE_ONLY=1 → seuls les e-mails d'INVITE_EMAILS peuvent
# se connecter/s'inscrire (liste séparée par virgules ; « @epfl.ch » = tout le
# domaine). Un non-invité ne reçoit même pas de lien.
# INVITE_ONLY=1
# INVITE_EMAILS=abensur.benjamin@gmail.com,@epfl.ch

# Quotas quotidiens PAR UTILISATEUR (non posé → pas de quota, dev) :
# générations par jobs (exam/qcm/exercice/labs/format/prepare)…
# DAILY_GEN_QUOTA=3
# …et appels d'assistance inline (drill, check-solution, analyse faiblesses).
# DAILY_ASSIST_QUOTA=20

# Rate-limit par IP (requêtes/minute, fenêtre fixe, in-process — 1 replica).
# RATE_LIMIT_PER_MIN=120
# Derrière un proxy de confiance (Railway) : prend la VRAIE IP (dernier élément
# de X-Forwarded-For) au lieu du premier, qui est forgeable par le client.
# À NE PAS poser en local (aucun proxy devant).
# TRUST_PROXY=1

# Démo publique en LECTURE SEULE (avec AUTH_ENABLED=1) : /, /revision, /projet
# restent visibles sans compte (contenu du tenant seedé « owner »). GET only.
# PUBLIC_DEMO=1

# ── Paiement Stripe · modèle CRÉDITS (Phase 5bis — mode TEST d'abord) ────────
# Active le débit de crédits par génération + le gate de solde (402).
# Non posé → aucune facturation (dev €0 et staging sans Stripe).
# BILLING_ENABLED=1

# Crédits offerts à l'inscription (une fois par user). Défaut : 2.
# SIGNUP_FREE_CREDITS=2

# Clés Stripe (test : sk_test_… / whsec_… du endpoint webhook). La bascule
# LIVE = remplacer ces clés + les price_ ci-dessous, zéro code.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Packs de crédits : id de prix Stripe (Produits → Prix) + nb de crédits.
# Le PRIX du crédit doit COUVRIR le coût API mesuré (table llm_usage) avec
# marge — jamais d'illimité. Cf. DEPLOY.md §Tarification pour le calcul.
# STRIPE_PRICE_SMALL=price_xxx      # ex. 1 crédit — 3 CHF
# STRIPE_PRICE_MEDIUM=price_xxx     # ex. 5 crédits — 12 CHF
# STRIPE_PRICE_LARGE=price_xxx      # ex. 12 crédits — 25 CHF
# CREDITS_PACK_SMALL=1
# CREDITS_PACK_MEDIUM=5
# CREDITS_PACK_LARGE=12

# Coût en crédits par type de génération (défauts : exam 2, prepare 2, qcm 1,
# exercise 1, lab-exercise 1, blueprint 1, format 1).
# CREDITS_COST_JSON={"exam":2,"qcm":1}
