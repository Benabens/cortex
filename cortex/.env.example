# ═══════════════════════════════════════════════════════════════════════════
# Cortex — configuration d'environnement (copie ce fichier en .env.local)
# .env.local n'est JAMAIS commité (cf. .gitignore).
#
# TOUT est optionnel : sans aucun fichier .env.local, l'app tourne en mode
# développement : moteur = CLI `claude` locale (`claude -p`), base = SQLite
# locale (data/), aucun service externe.
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────── Moteur LLM ───────────────────────────────────
# Provider des appels IA : claude-code (défaut — CLI locale, pour le
# développement) | anthropic (API officielle) | openai-compatible (endpoint générique /chat/completions,
# ex. NVIDIA NIM build.nvidia.com — gratuit —, vLLM, OpenRouter…).
# LLM_PROVIDER=claude-code

# Clé API des providers API (anthropic / openai-compatible si le endpoint l'exige).
# Repli accepté : ANTHROPIC_API_KEY (historique).
# LLM_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint du provider openai-compatible (racine SANS /chat/completions).
# Ex. NVIDIA NIM : https://integrate.api.nvidia.com/v1
# (Sert aussi de baseURL de test pour le provider anthropic.)
# LLM_BASE_URL=

# Mapping des modèles logiques (opus/sonnet/haiku) vers les ids du backend.
# claude-code : inutile (le CLI comprend les alias). anthropic : défauts
# claude-opus-4-8 / claude-sonnet-5 / claude-haiku-4-5-20251001.
# openai-compatible : FORTEMENT recommandé (aucun défaut sensé).
# LLM_MODEL_OPUS=
# LLM_MODEL_SONNET=
# LLM_MODEL_HAIKU=

# Concurrence max des appels LLM (limiteur global, file FIFO). Défaut : 4.
# LLM_MAX_CONCURRENCY=4

# RE-tentatives sur erreur retryable (429/5xx/réseau), backoff exponentiel+jitter.
# Défaut : 0 pour claude-code (comportement historique), 2 pour les providers API.
# LLM_MAX_RETRIES=
# LLM_RETRY_BASE_MS=500

# Chemin du binaire claude si non détecté automatiquement (PATH + emplacements connus).
# CORTEX_CLAUDE_BIN=/opt/homebrew/bin/claude

# ───────────────────────────── Base de données ──────────────────────────────
# Driver : sqlite (défaut — fichiers data/, dev €0, mono-user « owner ») |
# postgres (produit multi-user : un schéma par (user, cours) via search_path).
# DB_DRIVER=sqlite

# Cible Postgres (requis si DB_DRIVER=postgres) :
#  - vrai serveur :   postgres://cortex:cortex@localhost:5433/cortex  (cf. docker-compose.yml)
#  - PGlite embarqué : pglite://./data/pg   (Postgres WASM in-process, zéro Docker — tests/démo)
# DATABASE_URL=
# Connexions max par tenant (postgres.js). Défaut : 3.
# PG_POOL_MAX=3
# Pools tenant gardés vivants simultanément (éviction LRU au-delà) — borne la
# consommation de max_connections quand beaucoup d'utilisateurs sont actifs.
# PG_MAX_TENANT_POOLS=8

# Migration des données locales : npx tsx scripts/migrate-to-postgres.ts [--user owner] [--drop]

# ───────────────────────────── Authentification ─────────────────────────────
# OPT-IN : sans AUTH_ENABLED=1, AUCUNE auth (mono-user owner, comportement
# historique). Avec auth : toute page/API exige une session (Google OAuth,
# et/ou magic-link e-mail si activé), l'utilisateur devient le tenant des données.
# ⚠ prod-boot REFUSE de démarrer si NODE_ENV=production ou BILLING_ENABLED=1
#   sans AUTH_ENABLED=1 (sinon chaque visiteur serait « owner »).
# AUTH_ENABLED=1
# AUTH_SECRET=  # requis si AUTH_ENABLED=1 — génère : openssl rand -base64 32

# Lien magique par e-mail : DÉSACTIVÉ par défaut (seconde voie d'inscription,
# envois déclenchables par n'importe qui). AUTH_EMAIL_ENABLED=1 pour l'activer —
# utile en dev sans Google : sans endpoint, le lien est LOGGÉ dans la console
# du serveur (hors production). Sinon POST {to, url, subject} sur l'endpoint.
# AUTH_EMAIL_ENABLED=1
# AUTH_EMAIL_ENDPOINT=
# AUTH_EMAIL_TOKEN=
# AUTH_EMAIL_FROM=cortex@localhost

# Google OAuth (optionnel) :
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Utilisateur des scripts CLI en mode postgres (défaut : owner).
# CORTEX_USER=owner

# ──────────────────────── Cache / observabilité ─────────────────────────────
# Cache LLM par hash de contenu (prompt+modèle+params) : le 2ᵉ appel identique
# ne rappelle pas le modèle (table llm_cache du tenant). OPT-IN. Défaut : off.
# CACHE_ENABLED=1

# Log structuré : niveau (debug|info|warn|error, défaut info) + format.
# LOG_LEVEL=info
# LOG_PRETTY=1   # lignes lisibles au lieu de JSON (dev)

# /api/metrics est PROTÉGÉ : sans ce token il répond 401. /api/health est public.
# METRICS_TOKEN=change-me

# ─────────────────────── Sandbox d'exécution ────────────────────────────────
# Binaires utilisés dans le bac à sable (cf. cortex/docs/SANDBOX.md).
# CORTEX_PYTHON=python3
# CORTEX_CC=cc
# CORTEX_SANDBOX=none   # (tests) force « aucune isolation » → exécution refusée

# ─────────────────────────── Génération / jobs ──────────────────────────────
# Timeout du lot de génération d'examen (ms). Défaut : 600000.
# CORTEX_BATCH_TIMEOUT_MS=600000
# Cours par défaut des scripts CLI (sinon cs-202).
# CORTEX_COURSE=cs-202

# ───────────────────── Déploiement (conteneur / prod) ───────────────────────
# Racine des données mutables (volume persistant). Non posée → ./data (dev/CI).
# CORTEX_DATA_DIR=/data

# Seed au boot (scripts/prod-boot.ts, appelé par docker-entrypoint.sh) : cours
# à hydrater depuis un contenu local si le tenant du user de seed est vide
# (aucun appel LLM). Vide par défaut : chaque utilisateur importe ses documents.
# CORTEX_SEED_COURSES=
# CORTEX_SEED_USER=owner

# Postgres : à 1, un NOUVEL utilisateur reçoit une copie SQL du contenu de cours
# du tenant de seed (jamais ses données personnelles). Utile seulement pour une
# démo avec un cours d'exemple dédié. Défaut : 0 — chaque compte démarre vide.
# SEED_NEW_TENANTS=0

# ── Garde-fous de COÛT ───────────────────────────────────────────────────────
# CONVENTION FAIL-CLOSED : dans une vraie mise en ligne
# (AUTH_ENABLED=1 ou BILLING_ENABLED=1), les quotas/plafonds ci-dessous ont une
# VALEUR PAR DÉFAUT même si la variable n'est pas posée — un oubli de config ne
# lève JAMAIS les limites. Pour LEVER une limite : pose-la à « unlimited » (ou
# none/off/-1). « 0 » = kill-switch (coupe tout). En dev €0 nu : aucune limite.
#
# Plafond de dépense GLOBAL en USD (somme table llm_usage). Atteint → appels des
# providers PAYANTS refusés (LlmError SPEND_CAP) ; le provider CLI local n'est
# jamais bloqué.
# FAIL-CLOSED : 50 $ par défaut en déploiement gardé (auth ou facturation) si la
# variable est oubliée ; « unlimited » lève. Un plafond global SEUL transforme
# un abuseur en déni de service pour tous : garde aussi le plafond PAR
# UTILISATEUR ci-dessous.
# SPEND_CAP_USD=200
#
# Plafond de dépense PAR UTILISATEUR et PAR JOUR (USD). FAIL-CLOSED : défaut
# 15 $/user/jour en déploiement gardé (bien au-dessus de l'usage réel le plus
# lourd ~6,6 $/jour) — backstop d'une boucle emballée. « unlimited » pour lever.
# SPEND_CAP_PER_USER_USD=15

# Sur le provider anthropic (payant), l'alias logique « opus » se résout vers
# SONNET par défaut (Opus coûte ~2,5× plus cher). Opus réel seulement si
# LLM_ALLOW_OPUS=1 (ou LLM_MODEL_OPUS posé explicitement).
# LLM_ALLOW_OPUS=

# Suivi d'usage : les appels PAYANTS sont TOUJOURS écrits dans llm_usage. Ceux
# du provider CLI local (claude-code) le sont dès qu'un déploiement est gardé
# (AUTH/BILLING) ; CORTEX_TRACK_USAGE=1 force ce suivi aussi en dev local
# (lignes marquées estimated=1, coût 0).
# CORTEX_TRACK_USAGE=

# ── Auth prod (complète la section Authentification ci-dessus) ───────────────
# Envoi RÉEL du magic-link via Resend (si AUTH_EMAIL_ENABLED=1 ; sinon
# AUTH_EMAIL_ENDPOINT générique ; en production, sans transport configuré, la
# demande de lien ÉCHOUE plutôt que d'écrire un jeton de session dans les logs).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# AUTH_EMAIL_FROM=Cortex <cortex@ton-domaine.ch>
# URL canonique du site (liens magic-link + cookies https derrière le proxy).
# AUTH_URL=https://cortex.ton-domaine.ch

# Lancement FERMÉ : INVITE_ONLY=1 → seuls les e-mails d'INVITE_EMAILS peuvent
# se connecter/s'inscrire (liste séparée par virgules ; « @exemple.edu » = tout
# le domaine). Un non-invité ne reçoit même pas de lien.
# INVITE_ONLY=1
# INVITE_EMAILS=toi@exemple.com,@ton-etablissement.edu

# Plafond d'un envoi d'annales (refs/upload), en Mo, contrôlé sur Content-Length
# AVANT lecture du corps. Défaut : 64.
# UPLOAD_MAX_MB=64

# Quotas quotidiens PAR UTILISATEUR (FAIL-CLOSED : défaut appliqué en
# déploiement gardé ; « unlimited » pour lever ; « 0 » coupe tout) :
# générations par jobs (exam/qcm/exercice/labs/format/prepare) — défaut 10/jour…
# DAILY_GEN_QUOTA=10
# …et appels d'assistance inline (drill, check-solution, analyse) — défaut 40/jour.
# C'est le SEUL frein du chemin « assist » (0 crédit) : le plus important.
# DAILY_ASSIST_QUOTA=40

# Limite de DÉBIT PAR UTILISATEUR et par minute (compté en base = par compte ET
# cross-instance, contrairement au rate-limit de bordure). Arrête une boucle
# scriptée bien avant le quota quotidien. FAIL-CLOSED, défaut 20/min.
# RATE_LIMIT_PER_USER_MIN=20

# Rate-limit de BORDURE, par IP (requêtes/minute, in-process, 1 replica) : filet
# anti-flood GROSSIER. FAIL-CLOSED : défaut coarse 240/min/IP en déploiement
# gardé ; « unlimited » pour lever. La limite fine par compte est ci-dessus.
# RATE_LIMIT_PER_MIN=240
# NOMBRE de proxys de confiance devant l'app (Railway = 1). Le rate-limit lit
# alors le N-ième élément de X-Forwarded-For EN PARTANT DE LA FIN. Non posé :
# les en-têtes client sont IGNORÉS (le comptage est global — limite grossière
# mais non contournable par un simple en-tête forgé).
# TRUST_PROXY=1

# Démo publique en LECTURE SEULE (avec AUTH_ENABLED=1) : /, /revision
# restent visibles sans compte (contenu du tenant seedé « owner »). GET only.
# PUBLIC_DEMO=1

# ── Paiement Stripe · modèle CRÉDITS (mode TEST d'abord) ────────────────────
# Active le débit de crédits par génération + le gate de solde (402).
# Non posé → aucune facturation (dev €0 et staging sans Stripe).
# BILLING_ENABLED=1

# Crédits offerts à l'inscription (une fois par user). Défaut : 2.
# SIGNUP_FREE_CREDITS=2

# Clés Stripe (test : sk_test_… / whsec_… du endpoint webhook). La bascule
# LIVE = remplacer ces clés + les price_ ci-dessous, zéro code.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Packs de crédits : id de prix Stripe (Produits → Prix) + nb de crédits.
# Le PRIX du crédit doit COUVRIR le coût API mesuré (table llm_usage) avec
# marge — jamais d'illimité. Cf. DEPLOY.md §Tarification pour le calcul.
# STRIPE_PRICE_SMALL=price_xxx      # ex. 1 crédit — 3 CHF
# STRIPE_PRICE_MEDIUM=price_xxx     # ex. 5 crédits — 12 CHF
# STRIPE_PRICE_LARGE=price_xxx      # ex. 12 crédits — 25 CHF
# CREDITS_PACK_SMALL=1
# CREDITS_PACK_MEDIUM=5
# CREDITS_PACK_LARGE=12

# Coût en crédits par type de génération (défauts : exam 2, prepare 2, qcm 1,
# exercise 1, lab-exercise 1, blueprint 1, format 1 ; « assist » = 0 pour les
# appels courts, qui exigent seulement un solde positif + le quota du jour).
# CREDITS_COST_JSON={"exam":2,"qcm":1}

# (Test local de l'image sans clé Resend) autorise l'écriture du magic-link
# dans les logs même en production. À NE JAMAIS poser sur un déploiement
# public : le lien est un jeton de connexion.
# CORTEX_ALLOW_LOGGED_MAGIC_LINK=1
