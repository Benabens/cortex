# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — la CLÉ API n'est JAMAIS commitée
.env*
!.env.example

# Données utilisateur : SYNCHRONISÉES via git (faiblesses, planning, exams, uploads)
# pour que la routine nocturne (cloud) et tous tes appareils partagent le même cerveau.
# Seuls les fichiers temporaires WAL/SHM de SQLite restent hors git.
/data/*.db-wal
/data/*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/refs/img/
data/exams/img/
data/exams/.gen-checkpoint.json
