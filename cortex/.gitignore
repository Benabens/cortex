# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — la CLÉ API n'est JAMAIS commitée
.env*
!.env.example

# Données utilisateur : SYNCHRONISÉES via git (faiblesses, planning, exams, uploads)
# pour que la routine nocturne (cloud) et tous tes appareils partagent le même cerveau.
# Seuls les fichiers temporaires WAL/SHM de SQLite restent hors git.
/data/*.db-wal
/data/*.db-shm
data/**/*.db-wal
data/**/*.db-shm

# Multi-cours : la DB et les artefacts générés des AUTRES cours sont reconstructibles par
# `npm run ingest -- --course=<id>` → hors git. Ben committe le CONTENU source
# (data/<id>/content + data/<id>/refs), pas la base ni les PDF générés.
data/algo/*.db
data/ml/*.db
data/algo/exams/
data/ml/exams/
# uploads cs-202 (binaires éphémères : screenshots faiblesses, images d'exos) — régénérables
data/uploads/
data/algo/uploads/
data/ml/uploads/
# images-étalon vision rendues depuis les PDF (V6 figref / V11 figref-full) — reconstructibles
data/**/figref/
data/**/figref-full/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/refs/img/
data/exams/img/
data/exams/.gen-checkpoint.json
# journaux d'audit architecte (copie de preuve committée dans data/refs/proof/)
data/exams/*.audit.json
# Artefacts d'examens GÉNÉRÉS localement (régénérables — ne pas versionner)
data/exams/*.pdf
data/exams/*.tex
data/exams/*.log
data/exams/*.aux
data/exams/*.out
data/exams/epfl-logo.*

# figref auto-générés des cours additionnels (rendus depuis les PDF de réf, reconstructibles)
data/algo/refs/figref/
data/ml/refs/figref/

# Store d'auth local (e-mails = données perso) — Phase B4 backend-overhaul
/data/auth.db
/data/auth.db-wal
/data/auth.db-shm

# artefacts FUSE (fichiers supprimés encore ouverts — incident disque)
.fuse_hidden*
**/.fuse_hidden*

# cours factice de preuve moteur-v2 (mêmes règles que algo/ml)
data/fictif/*.db
data/fictif/exams/
data/fictif/uploads/
data/fictif/refs/figref/
data/fictif/refs/figref-full/
